# ---------------------------------------------------------------------------
# Supabase -- Project Settings > API
# Both deployments need all three: the public form inserts and uploads with the
# secret key, and the admin editor uses it for logo storage writes.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret / service_role key -- SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used for public form inserts and the private applicant-logos bucket.
SUPABASE_SECRET_KEY=sb_secret_xxx


# ---------------------------------------------------------------------------
# Domain split -- see DOMAINS.md
#
# The form and the dashboard run as two Vercel projects off this one repo.
# APP_TARGET tells a build which half it serves; the other half is redirected
# to its sibling domain.
#
# Leave all three UNSET for local development: `npm run dev` then serves the
# whole app on localhost:3000 with relative links, exactly as before the split.
# ---------------------------------------------------------------------------

# "form" | "admin" | "all"   (unset behaves as "all")
# APP_TARGET=all

# Where each half lives in production. A bare hostname or a full https:// URL
# both work. Set BOTH on BOTH projects -- each one needs to know where to send
# the traffic that is not its own.
# FORM_ORIGIN=https://awe.adwizersnetworks.in
# ADMIN_ORIGIN=https://admin.adwizersnetworks.in


# ---------------------------------------------------------------------------
# Resend -- nominee selection emails (Final Plan section 3)
#
# Set these on the ADMIN deployment: promotion happens in the dashboard, so the
# form project never sends anything. Both are optional -- with no key, promotion
# still works and each nominee is recorded as "Not sent", with a Send button on
# the Nominees screen for once this is filled in.
# ---------------------------------------------------------------------------

# resend.com > API Keys. Server-only; never prefix with NEXT_PUBLIC_.
# RESEND_API_KEY=re_xxx

# Must be an address on a domain verified in Resend. Left unset, sends fall back
# to Resend's shared test sender, which only delivers to the account owner --
# every other nominee shows as sent and receives nothing.
# RESEND_FROM=AWE Awards 2026 <awards@adwizersnetworks.in>


# ---------------------------------------------------------------------------
# Cloudflare Turnstile -- captcha on every vote (Final Plan section 8)
#
# Set on the FORM deployment: the ballot lives there. Both halves are required
# -- a site key with no secret renders a widget nothing ever checks, which is
# worse than no widget because it looks protected.
#
# With neither set, voting still works and the dashboard says the captcha is
# missing. Free account -> Turnstile -> add a site.
# ---------------------------------------------------------------------------

# Public. Renders the widget.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Server-only. Never prefix with NEXT_PUBLIC_.
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
